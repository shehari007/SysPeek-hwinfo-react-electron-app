{
  "name": "syspeek-systeminfo-viewer",
  "version": "2.0.0",
  "author": {
    "name": "Muhammad Sheharyar Butt",
    "email": "shehariyar@gmail.com",
    "url": "https://github.com/shehari007"
  },
  "description": "SysPeek is a modern, secure cross platform desktop app for detailed system information and live hardware monitoring.",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "homepage": "https://github.com/shehari007/SysPeek-hwinfo-react-electron-app",
  "repository": {
    "type": "git",
    "url": "https://github.com/shehari007/SysPeek-hwinfo-react-electron-app.git"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "electron-vite dev --watch",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,css,md,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,css,md,yml}\"",
    "verify": "npm run typecheck && npm run lint && npm run build",
    "verify:manifest": "node scripts/verify-update-manifest.mjs",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "release:win": "npm run typecheck && npm run build:win && npm run verify:manifest",
    "release:mac": "npm run typecheck && npm run build:mac && npm run verify:manifest",
    "release:linux": "npm run typecheck && npm run build:linux && npm run verify:manifest",
    "release": "npm run build && electron-builder --publish always"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "systeminformation": "^5.33.1"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.3.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "antd": "^6.5.2",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "uplot": "^1.6.32",
    "uplot-react": "^1.2.4",
    "vite": "^7.3.6"
  }
}
